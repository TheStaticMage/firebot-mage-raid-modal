        "@types/jest": "^30.0.0",
        "html-loader": "^5.1.0",
        "jest": "^30.0.4",
        "terser-webpack-plugin": "^5.3.10",
        "ts-jest": "^29.4.0",
        "ts-loader": "^9.5.1",
        "typescript": "^5.3.3",
        "webpack": "^5.89.0",
        "webpack-cli": "^6.0.1"
    },
    "dependencies": {
        "@leeoniya/ufuzzy": "^1.0.19",
        "closest-match": "^1.3.3"
    }
